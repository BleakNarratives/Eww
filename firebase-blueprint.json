{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Core user identity and role data",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "role": { "type": "string", "enum": ["user", "admin", "sovereign"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Message": {
      "title": "Mainframe Message",
      "description": "Persisted chat history between meatsuit and OS",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Owner UID" },
        "role": { "type": "string", "enum": ["user", "ai"] },
        "content": { "type": "string" },
        "mode": { "type": "string", "enum": ["builder", "executive"] },
        "hat": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "role", "content", "mode", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user profiles"
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Global message log (filtered by UID in rules)"
    }
  }
}
